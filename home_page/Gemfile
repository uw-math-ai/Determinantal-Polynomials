source "https://rubygems.org"

# The site is built by `jekyll build` in CI (leanprover-community/docgen-action) and deployed with
# actions/deploy-pages, so we use plain Jekyll rather than the frozen `github-pages` gem.
gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-remote-theme"   # `remote_theme: pages-themes/cayman` in _config.yml
  gem "jekyll-github-metadata" # `site.github.*` in _layouts/default.html
  gem "jekyll-seo-tag"         # `{% seo %}` in _layouts/default.html
end

# Used for locally serving the website (`bundle exec jekyll serve`).
gem "webrick", "~> 1.9"
